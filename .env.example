# Vasool — environment reference.
#
# Copy to `.env` for local development and fill in what you need. In production
# every value is injected by the platform's secret store; nothing here is
# committed with a real value, and the app refuses to start in staging/production
# without SECRET_KEY and FIELD_ENCRYPTION_KEY set explicitly.
#
# Generate the two keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# --- Core ---
# dev | staging | prod. Anything but dev enables the production start-up checks.
APP_ENV=dev
APP_NAME=Vasool
# Public base URL, no trailing slash. Used to build payment and portal links.
BASE_URL=http://127.0.0.1:8000

# --- Secrets (REQUIRED in staging/prod) ---
# Signs session cookies and the CSRF cookie. Rotating it logs everyone out.
SECRET_KEY=
# Encrypts each merchant's payment-gateway credentials at rest.
FIELD_ENCRYPTION_KEY=

# --- Database ---
# Local development uses SQLite. Production should use PostgreSQL.
DATABASE_URL=sqlite+pysqlite:///./vasool.db
# Example production value:
# DATABASE_URL=postgresql+psycopg://vasool:REPLACE_ME@db:5432/vasool

# --- Payments ---
# mock | razorpay | cashfree. 'mock' is the sandbox adapter: it exists so the
# whole flow can be exercised in development and in tests with no real gateway.
PAYMENT_PROVIDER=mock
# sandbox | live. Switching to live is this one value plus live keys.
PAYMENT_MODE=sandbox

# Platform-level gateway credentials (used for Vasool's own subscription billing).
# A merchant's own credentials are entered in the app and stored encrypted.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# --- Messaging ---
# console | whatsapp | sms_dlt | email.
# 'console' logs messages and never touches a network — the development default.
MESSAGING_PROVIDER=console

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_URL=

# Indian transactional SMS needs DLT registration; without all five values the
# SMS adapter refuses to send rather than emitting a message that gets blocked.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=

# Transactional email over SMTP — no proprietary dependency required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.in

# --- Abuse protection ---
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
LOGIN_MAX_PER_IP_PER_HOUR=30
GLOBAL_RATE_LIMIT_PER_MINUTE=240

# --- Operations / compliance ---
# CERT-In (No. 20(3)/2022-CERT-In) requires reporting within 6 hours and 180 days
# of log retention inside India. These drive the ops dashboards and the
# maintenance job, so keep them in step with the direction.
CERT_IN_REPORT_HOURS=6
LOG_RETENTION_DAYS=180
BACKUP_DIR=./backups
# Set to 1 when TLS terminates in front of the app so HSTS is emitted.
ENABLE_HSTS=0

# --- Business defaults (India) ---
SAC_CODE_DEFAULT=998314
# MSMED s.16 compound interest is 3x the RBI-notified bank rate. Leave at 0 until
# the current rate has been verified on rbi.org.in; the product shows no interest
# figure rather than guessing one.
RBI_BANK_RATE_PERCENT=0

# --- Tests only ---
# Throwaway credential for the suite's temp database.
TEST_LOGIN_VALUE=correcthorse1
